# Google AI Studio (Gemini) key for the COBALT platform assistant.
# Get one free at https://aistudio.google.com/apikey
#
# Copy this file to `.env` (which is gitignored) and fill in the key:
#   cp .env.example .env
#
# Leave it unset and the assistant is simply hidden — the rest of COBALT
# runs normally.
GEMINI_API_KEY=

# Optional. Must be a model your key can access; see your AI Studio console.
GEMINI_MODEL=gemini-2.5-flash
